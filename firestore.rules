rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // School profile data: public read, admin write
    match /profiles/{profileId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // News articles: public read, authenticated teacher/admin write
    match /news/{newsId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Innovation media items: public read, authenticated teacher/admin write
    match /media/{mediaId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Default catch-all
    match /{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
